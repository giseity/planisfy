{
  "logger": {
    "level": "info",
    "timestamp": true
  },
  "esclient": {
    "apiVersion": "7.x",
    "hosts": [
      {
        "host": "pelias-elasticsearch",
        "port": 9200
      }
    ],
    "connection": {
      "url": "http://pelias-elasticsearch:9200"
    }
  },
  "elasticsearch": {
    "indexPrefix": "pelias"
  },
  "api": {
    "indexName": "pelias_live",
    "basePath": "/v1",
    "services": {
      "placeholder": {
        "url": "http://placeholder:4100"
      },
      "pip": {
        "url": "http://pip:4200"
      },
      "libpostal": {
        "url": "http://libpostal:4400"
      }
    }
  },
  "apis": {
    "autocomplete": {},
    "reverse": {},
    "search": {}
  },
  "imports": {
    "whosonfirst": {
      "datapath": "/data/whosonfirst"
    }
  }
}
